{
  "title": "FinOps AI Lab",
  "tags": ["finops", "kubernetes", "ai"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Cluster CPU Usage",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(node_cpu_seconds_total{mode!=\"idle\"}[5m]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cluster Memory Usage (GB)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes-node_memory_MemAvailable_bytes)/1024/1024/1024"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },

    {
      "id": 3,
      "type": "gauge",
      "title": "Payments CPU (mCPU)",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{cpu=\"total\",namespace=\"payments\"}[5m]))*1000"
        }
      ]
    },

    {
      "id": 4,
      "type": "gauge",
      "title": "Users CPU (mCPU)",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{cpu=\"total\",namespace=\"users\"}[5m]))*1000"
        }
      ]
    },

    {
      "id": 5,
      "type": "gauge",
      "title": "Staging CPU (mCPU)",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 5 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{cpu=\"total\",namespace=\"staging\"}[5m]))*1000"
        }
      ]
    },

    {
      "id": 6,
      "type": "gauge",
      "title": "Payments Memory (MiB)",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"payments\"})/1024/1024"
        }
      ]
    },

    {
      "id": 7,
      "type": "gauge",
      "title": "Users Memory (MiB)",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 5 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"users\"})/1024/1024"
        }
      ]
    },

    {
      "id": 8,
      "type": "gauge",
      "title": "Staging Memory (MiB)",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 5 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"staging\"})/1024/1024"
        }
      ]
    },

    {
      "id": 9,
      "type": "table",
      "title": "Top CPU Consumers",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 11 },
      "targets": [
        {
          "expr": "topk(10,sum by(namespace,pod)(rate(container_cpu_usage_seconds_total{cpu=\"total\"}[5m]))*1000)",
          "instant": true,
          "format": "table"
        }
      ]
    },

    {
      "id": 10,
      "type": "table",
      "title": "Top Memory Consumers",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 11 },
      "targets": [
        {
          "expr": "topk(10,sum by(namespace,pod)(container_memory_working_set_bytes)/1024/1024)",
          "instant": true,
          "format": "table"
        }
      ]
    }
  ]
}